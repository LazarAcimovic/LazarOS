# Backend environment — copy to `.env` and fill in. `.env` is gitignored.

# HTTP port the API listens on.
PORT=5000

# PostgreSQL connection for the `pg` driver (Tech §2–§3, D-016).
# Example: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/LazarOS

# PostgreSQL connection used by the backend test suite (a separate database on the same
# server). The vitest setup drops and recreates its tables here; never point it at the dev DB.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/LazarOS_Test

# Required to sign and verify the session JWT. There is no fallback —
# login throws without it. Use a long random string.
JWT_SECRET=replace-me-with-a-long-random-string

# Optional. Set to `production` to flip the JWT cookie's `secure` flag on.
# NODE_ENV=production
