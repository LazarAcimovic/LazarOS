generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model profiles {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name String   @db.VarChar(100)
  last_name  String   @db.VarChar(100)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  created_at DateTime @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  tasks      tasks[]
  password_reset_tokens password_reset_tokens[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tasks {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  title        String    @db.VarChar(255)
  description  String?
  due_date     DateTime  @db.Date
  priority     String    @default("medium") @db.VarChar(10)
  status       String    @default("pending") @db.VarChar(10)
  is_deleted   Boolean   @default(false)
  completed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at   DateTime  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  profiles     profiles  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_tasks_profiles")

  @@index([due_date], map: "IX_tasks_due_date")
  @@index([status], map: "IX_tasks_status")
  @@index([user_id, is_deleted, status, due_date], map: "IX_tasks_user_active")
  @@index([user_id], map: "IX_tasks_user_id")
}

// Single-use password-reset tokens (task-05). Only the token HASH is stored, never the raw token
// (PRD §7); the unique index on token_hash supports the lookup. No cascade — there is no profile
// delete. Added code-first: edit this model, then `prisma migrate dev` (D-019).
model password_reset_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  profiles   profiles  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_password_reset_tokens_profiles")
}
